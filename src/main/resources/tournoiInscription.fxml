<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0d1b3e;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.TournoiInscriptionController">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          style="-fx-background-color: linear-gradient(to bottom, #0d1b3e, #111c3e);">
        <fx:include source="Navbar.fxml"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="18" style="-fx-padding: 22 26 26 26;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Retour" onAction="#handleBack"
                                style="-fx-background-color: transparent; -fx-text-fill: #93c5fd; -fx-underline: true;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="titleLabel" text="Inscription tournoi"
                               style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                    </HBox>

                    <VBox spacing="10" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16;">
                        <Label fx:id="tournoiLabel" text="Tournoi"
                               style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>
                        <HBox spacing="20">
                            <VBox>
                                <Label text="Jeu" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                                <Label fx:id="jeuLabel" text="—" style="-fx-text-fill: #f472b6; -fx-font-size: 14; -fx-font-weight: bold;"/>
                            </VBox>
                            <VBox>
                                <Label text="Places" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                                <Label fx:id="placesLabel" text="0/0" style="-fx-text-fill: #a78bfa; -fx-font-size: 14; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="10" style="-fx-background-color: #111a33; -fx-border-color: #26365f; -fx-border-radius: 14; -fx-background-radius: 14; -fx-padding: 16;">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Règle" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label text="Vous devez être dans une équipe pour s'inscrire." style="-fx-text-fill: #e2e8f0; -fx-font-size: 12;" wrapText="true"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="👥 Rejoindre une équipe" onAction="#handleGoTeams"
                                    style="-fx-background-color: #26365f; -fx-text-fill: #e2e8f0; -fx-background-radius: 999; -fx-padding: 8 16; -fx-cursor: hand;"/>
                        </HBox>
                        <Label text="Nom *" style="-fx-text-fill: #e2e8f0;"/>
                        <TextField fx:id="nomField" promptText="Votre nom"
                                   style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 10;"/>
                        <Label text="Email *" style="-fx-text-fill: #e2e8f0;"/>
                        <TextField fx:id="emailField" promptText="ex: nom@email.com"
                                   style="-fx-background-color: #0f172a; -fx-text-fill: white; -fx-prompt-text-fill: #64748b; -fx-background-radius: 10;"/>

                        <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
                            <Button text="✅ Confirmer l'inscription" onAction="#handleSubmit"
                                    style="-fx-background-color: linear-gradient(to right, #db2777, #9333ea); -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold; -fx-background-radius: 12; -fx-pref-height: 44; -fx-cursor: hand;"/>
                        </HBox>

                        <Label fx:id="statusLabel" text="Prêt." wrapText="true"
                               style="-fx-text-fill: #cbd5e1; -fx-font-size: 13;"/>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>

