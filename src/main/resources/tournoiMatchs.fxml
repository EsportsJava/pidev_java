<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.TournoiMatchsController"
      prefHeight="720.0" prefWidth="1280.0"
      style="-fx-background-color: #0d1b3e;">

    <fx:include source="Navbar.fxml"/>

    <VBox fx:id="mainContent" spacing="18" VBox.vgrow="ALWAYS" style="-fx-padding: 18 28 20 28;">

        <!-- Back button + Header -->
        <HBox spacing="14" alignment="CENTER_LEFT">
            <Button fx:id="backBtn" text="← Retour" onAction="#handleBack"
                    style="-fx-background-color: rgba(124,58,237,0.15); -fx-text-fill: #c4b5fd;
                           -fx-font-size: 13px; -fx-font-weight: 700;
                           -fx-background-radius: 10; -fx-pref-height: 38;
                           -fx-border-color: rgba(124,58,237,0.3); -fx-border-radius: 10;
                           -fx-cursor: hand; -fx-padding: 0 18;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Tournament Info Header -->
        <HBox fx:id="headerBox" spacing="20" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #1a0b2e, #0d1b3e);
                     -fx-background-radius: 16; -fx-border-color: #d63384;
                     -fx-border-radius: 16; -fx-border-width: 2; -fx-padding: 22 28;">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="tournoiNameLabel" text="Tournoi"
                       style="-fx-text-fill: #f8fafc; -fx-font-size: 24px; -fx-font-weight: 800;"/>
                <Label fx:id="tournoiInfoLabel" text=""
                       style="-fx-text-fill: #f472b6; -fx-font-size: 14px; -fx-font-weight: 600;"/>
                <Label fx:id="tournoiDateLabel" text=""
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" minWidth="120"
                  style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 12; -fx-padding: 12 16;">
                <Label text="MATCHS" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: 700;"/>
                <Label fx:id="matchCountLabel" text="0"
                       style="-fx-text-fill: #a78bfa; -fx-font-size: 28px; -fx-font-weight: 800;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" minWidth="120"
                  style="-fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 12; -fx-padding: 12 16;">
                <Label text="TERMINÉS" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: 700;"/>
                <Label fx:id="finishedCountLabel" text="0"
                       style="-fx-text-fill: #4ade80; -fx-font-size: 28px; -fx-font-weight: 800;"/>
            </VBox>
        </HBox>

        <!-- Matches List -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox fx:id="matchCardsContainer" spacing="12" fillWidth="true"
                      style="-fx-padding: 2 0 12 0;"/>
            </content>
        </ScrollPane>

        <Label fx:id="messageLabel" text="" style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
    </VBox>
</VBox>
