<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.equipe.ManageMembersController"
            prefHeight="600.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0a0f1e, #111936);">

    <VBox spacing="20"
          AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <!-- Header -->
        <VBox spacing="10">
            <Label fx:id="titleLabel" text="Gérer les membres"
                   style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: #f8fafc;"/>
            <Label fx:id="equipeInfoLabel" text="Équipe: "
                   style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- Add Member Section -->
        <VBox spacing="10"
              style="-fx-background-color: #151d3a; -fx-padding: 15;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(124,58,237,0.20); -fx-border-radius: 12; -fx-border-width: 1;">
            <Label text="Ajouter un membre"
                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #f8fafc;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="userComboBox" promptText="Sélectionner un utilisateur"
                          prefWidth="300"
                          style="-fx-background-color: #0a0f1e; -fx-text-fill: white;
                                 -fx-background-radius: 8; -fx-border-color: rgba(124,58,237,0.3);
                                 -fx-border-radius: 8; -fx-border-width: 1;"/>
                <Button fx:id="addMemberBtn" text="Ajouter"
                        onAction="#handleAddMember"
                        style="-fx-background-color: linear-gradient(to right, #7c3aed, #8b5cf6);
                               -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: 700;
                               -fx-background-radius: 8; -fx-cursor: hand;
                               -fx-pref-height: 35; -fx-pref-width: 100;"/>
            </HBox>
        </VBox>

        <!-- Current Members -->
        <VBox spacing="10"
              style="-fx-background-color: #151d3a; -fx-padding: 15;
                     -fx-background-radius: 12;
                     -fx-border-color: rgba(14,165,233,0.20); -fx-border-radius: 12; -fx-border-width: 1;">
            <Label text="Membres actuels"
                   style="-fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #f8fafc;"/>
            <TableView fx:id="membersTable" prefHeight="300"
                       style="-fx-background-color: #111b3e; -fx-background-radius: 8;
                              -fx-border-color: rgba(124,58,237,0.15); -fx-border-radius: 8;">
                <columns>
                    <TableColumn fx:id="nomCol" text="Nom" prefWidth="200">
                        <cellValueFactory>
                            <PropertyValueFactory property="nom"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="emailCol" text="Email" prefWidth="250">
                        <cellValueFactory>
                            <PropertyValueFactory property="email"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="actionsCol" text="Actions" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Message Label -->
        <Label fx:id="messageLabel" text=""
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>

        <!-- Close Button -->
        <HBox alignment="CENTER_RIGHT">
            <Button text="Fermer" onAction="#handleClose"
                    style="-fx-background-color: #374151; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-pref-height: 35; -fx-pref-width: 100;"/>
        </HBox>
    </VBox>
</AnchorPane>