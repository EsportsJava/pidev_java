<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #0d1b3e;"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.TournoiKpiController">
    <VBox AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          style="-fx-background-color: linear-gradient(to bottom, #0d1b3e, #111c3e);">
        <fx:include source="Navbar.fxml"/>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="14" style="-fx-padding: 22 26 26 26;">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button text="← Retour Tournois" onAction="#handleBack"
                                style="-fx-background-color: transparent; -fx-text-fill: #93c5fd; -fx-underline: true;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Période :" style="-fx-text-fill: #cbd5e1; -fx-font-size: 13;"/>
                        <ComboBox fx:id="periodeCombo" prefWidth="170"
                                  style="-fx-background-color: #1e2d4a; -fx-text-fill: white;"/>
                    </HBox>

                    <VBox spacing="4">
                        <Label text="KPIs Tournois" style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;"/>
                        <Label text="Vue de pilotage pour les décisions admin" style="-fx-text-fill: #94a3b8; -fx-font-size: 13;"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox prefWidth="170" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Total global" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="totalGlobalLabel" text="0" style="-fx-text-fill: #a78bfa; -fx-font-size: 24; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox prefWidth="170" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Total période" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="totalPeriodeLabel" text="0" style="-fx-text-fill: #a78bfa; -fx-font-size: 24; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox prefWidth="190" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Ouverts (Planifié + En cours)" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="ouvertsLabel" text="0" style="-fx-text-fill: #4ade80; -fx-font-size: 24; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox prefWidth="260" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Taux de remplissage" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="remplissageLabel" text="N/A" style="-fx-text-fill: #f8fafc; -fx-font-size: 15; -fx-font-weight: bold;" wrapText="true"/>
                        </VBox>
                        <VBox prefWidth="220" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Cagnotte totale" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="cagnotteTotalLabel" text="0 TND" style="-fx-text-fill: #f472b6; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox prefWidth="220" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 10;">
                            <Label text="Cagnotte moyenne / tournoi" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;"/>
                            <Label fx:id="cagnotteMoyenneLabel" text="0 TND" style="-fx-text-fill: #f472b6; -fx-font-size: 22; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="12">
                        <VBox prefWidth="420" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                            <Label text="Répartition par statut" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
                            <PieChart fx:id="statutPieChart" labelsVisible="true" legendVisible="true" prefHeight="300"/>
                        </VBox>

                        <VBox prefWidth="420" style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;" VBox.vgrow="ALWAYS">
                            <Label text="Frais moyens par type" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
                            <BarChart fx:id="fraisTypeChart" prefHeight="300" legendVisible="false">
                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis/>
                                </yAxis>
                            </BarChart>
                        </VBox>
                    </HBox>

                    <VBox style="-fx-background-color: #1e2d4a; -fx-border-color: #334155; -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 12;">
                        <Label text="Top jeux rentables (somme cagnotte par jeu)" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
                        <TableView fx:id="topJeuxTable" prefHeight="220">
                            <columns>
                                <TableColumn fx:id="jeuCol" text="Jeu" prefWidth="420"/>
                                <TableColumn fx:id="montantCol" text="Cagnotte cumulée" prefWidth="220"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</AnchorPane>

